{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Proxy",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/bouncer-cli/src/main.mts",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Attach Proxy",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "0.0.0.0",
      "remoteRoot": "/usr/dev",
      "localRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/usr/dev/*": "${workspaceRoot}/*"
      }
    }
  ]
}
