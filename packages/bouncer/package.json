{
  "name": "@zthun/bouncer",
  "version": "3.0.0",
  "description": "A declarative reverse proxy server in nodejs.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/bouncer",
    "directory": "packages/bouncer"
  },
  "types": "./dist/index.d.mts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    "types": "./dist/index.d.mts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "bin": "./bin/cli.mjs",
  "scripts": {
    "build": "vite build",
    "debug": "tsx --inspect=0.0.0.0:9229 ./src/cli.mts",
    "start": "node ./bin/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zthun/helpful-fn": "^9.11.1",
    "@zthun/lumberjacky-log": "^4.0.2",
    "@zthun/webigail-http": "^5.0.2",
    "@zthun/webigail-url": "^5.0.2",
    "cosmiconfig": "^9.0.0",
    "http-reverse-proxy-ts": "^1.0.1",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@zthun/janitor-build-config": "^19.5.3",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
