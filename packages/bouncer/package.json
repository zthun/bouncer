    "cosmiconfig": "^10.0.0",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@zthun/janitor-build-config": "^21.0.0",
    "@zthun/janitor-ts-config": "^21.0.0",
    "tsx": "^4.23.11",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
